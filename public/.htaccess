<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Paksa HTTPS dan canonical host tanpa mempercayai HTTP_HOST dari request.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^bionora\.my\.id$ [NC]
  RewriteRule ^ https://bionora.my.id%{REQUEST_URI} [L,R=301,NE]

  # Jangan sajikan dotfiles, source tree, konfigurasi proyek, atau artefak backup.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
  RewriteRule ^(?:src|sot|node_modules|vendor)(?:/|$) - [F,L,NC]
  RewriteRule ^(?:AGENTS\.md|package(?:-lock)?\.json|vite\.config\.js|tailwind\.config\.js|postcss\.config\.js|wrangler\.json|netlify\.toml)$ - [F,L,NC]
  RewriteRule \.(?:bak|backup|old|sql|dump|log|zip|tar|gz|rar|pem|key|env)$ - [F,L,NC]

  # SPA Routing Fallback
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Lapisan tambahan untuk Apache 2.4 jika file sensitif pernah ikut terunggah.
<IfModule mod_authz_core.c>
  <FilesMatch "^(?:\.env(?:\..*)?|\.git|.*\.(?:bak|backup|old|sql|dump|log|zip|tar|gz|rar|pem|key)|(?:AGENTS|package(?:-lock)?|vite\.config|tailwind\.config|postcss\.config|wrangler|netlify)\.(?:md|json|js|toml))$">
    Require all denied
  </FilesMatch>
</IfModule>

# Security headers untuk deployment Apache/cPanel.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), microphone=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>
